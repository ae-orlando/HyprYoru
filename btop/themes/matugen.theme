# Matugen template for btop - generated from /home/orlando/Pictures/wallpapers/3d-tech.jpg

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#f0dfd8"

# Title color for boxes
theme[title]="#ffb692"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#e6beac"

# Background color of selected item in processes box
theme[selected_bg]="#ffb692"

# Foreground color of selected item in processes box
theme[selected_fg]="#542103"

# Color of inactive/disabled text
theme[inactive_fg]="#d7c2b9"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#cfc890"

# Cpu box outline color
theme[cpu_box]="#a08d85"

# Memory/disks box outline color
theme[mem_box]="#a08d85"

# Net up/down box outline color
theme[net_box]="#a08d85"

# Processes box outline color
theme[proc_box]="#a08d85"

# Box divider line and small boxes line color
theme[div_line]="#52443d"

# Temperature graph colors
theme[temp_start]="#e6beac"
theme[temp_mid]="#ffb692"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#e6beac"
theme[cpu_mid]="#ffb692"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter
theme[free_start]="#e6beac"
theme[free_mid]=""
theme[free_end]="#5c4033"

# Mem/Disk cached meter
theme[cached_start]="#cfc890"
theme[cached_mid]=""
theme[cached_end]="#4c481c"

# Mem/Disk available meter
theme[available_start]="#ffb692"
theme[available_mid]=""
theme[available_end]="#703716"

# Mem/Disk used meter
theme[used_start]="#ffb4ab"
theme[used_mid]=""
theme[used_end]="#93000a"

# Download graph colors
theme[download_start]="#e6beac"
theme[download_mid]="#ffb692"
theme[download_end]="#cfc890"

# Upload graph colors
theme[upload_start]="#e6beac"
theme[upload_mid]="#ffb692"
theme[upload_end]="#cfc890"
