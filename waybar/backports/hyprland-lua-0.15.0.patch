+++ b/include/util/hyprland_workspace_command.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+// Hyprland Lua workspace IPC compatibility.
+// Author: ae Orland
+// GitHub: https://github.com/ae-orlando
+#include <string>
+#include <string_view>
+
+namespace waybar::util {
+
+inline std::string quoteLua(std::string_view value) {
+  std::string quoted = "\"";
+  for (unsigned char character : value) {
+    if (character == '\\' || character == '"') {
+      quoted += '\\';
+      quoted += static_cast<char>(character);
+    } else if (character < 32 || character == 127) {
+      // Three decimal digits avoid consuming following digits in a Lua escape.
+      quoted += '\\';
+      quoted += static_cast<char>('0' + character / 100);
+      quoted += static_cast<char>('0' + character / 10 % 10);
+      quoted += static_cast<char>('0' + character % 10);
+    } else {
+      quoted += static_cast<char>(character);
+    }
+  }
+  return quoted + '"';
+}
+
+inline std::string hyprlandWorkspaceCommand(int id, std::string_view name, bool special,
+                                           bool moveToMonitor) {
+  if (special) {
+    return "dispatch hl.dsp.workspace.toggle_special(" + quoteLua(id == -99 ? "" : name) + ")";
+  }
+  const auto selector = id > 0 ? std::to_string(id) : "name:" + std::string(name);
+  return "dispatch hl.dsp.focus({workspace=" + quoteLua(selector) +
+         ",on_current_monitor=" + (moveToMonitor ? "true" : "false") + "})";
+}
+
+}  // namespace waybar::util
