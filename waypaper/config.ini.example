[Settings]
# backend=none: waypaper never sets wallpaper itself; post_command hands
# off to set-wall.sh, which runs awww (center 2s) then matugen palette-only.
backend = none
folder = ~/Pictures/wallpapers
monitors = All
fill = fill
post_command = ~/.config/hypr/scripts/set-wall.sh $wallpaper
language = en
wallpaper = ~/Pictures/wallpapers/mystical-night-in-town.jpg
show_path_in_tooltip = True
sort = name
color = #ffffff
subfolders = False
all_subfolders = False
show_hidden = False
show_gifs_only = False
zen_mode = False
slideshow_interval = 60
slideshow_enabled = False
show_slideshow_panel = False
number_of_columns = 3
# NOTE: swww_* keys are ignored with backend=none (awww owns the transition
# in set-wall.sh); kept out of the seed to avoid swww/awww confusion.
mpvpaper_sound = False
mpvpaper_options = 
use_xdg_state = False
stylesheet = ~/.config/waypaper/style.css
keybindings = ~/.config/waypaper/keybindings.ini
wallpaperengine_folder = ~/.steam/root/steamapps/workshop/content/431960
linux_wallpaperengine_clamp = none
linux_wallpaperengine_volume = 15
linux_wallpaperengine_silent = False
linux_wallpaperengine_noautomute = False
linux_wallpaperengine_no_audio_processing = False
linux_wallpaperengine_fps = 30
linux_wallpaperengine_disable_particles = True
linux_wallpaperengine_disable_mouse = False
linux_wallpaperengine_disable_parallax = False
linux_wallpaperengine_no_fullscreen_pause = False

