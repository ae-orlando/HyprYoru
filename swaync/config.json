{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "cssPriority": "user",
    "control-center-width": 420,
    "control-center-height": 820,
    "control-center-margin-top": 14,
    "control-center-margin-bottom": 14,
    "control-center-margin-right": 14,
    "control-center-margin-left": 0,
    "notification-window-width": 380,
    "notification-window-height": -1,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "timeout": 6,
    "timeout-low": 3,
    "timeout-critical": 0,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "text-empty": "No notifications — enjoy the quiet",
    "script-fail-notify": true,
    "notification-grouping": true,
    "relative-timestamps": true,
    "notification-inline-replies": true,
    "notification-2fa-action": true,
    "notification-visibility": {
        "spotify-low": {
            "state": "muted",
            "urgency": "Low",
            "app-name": "Spotify"
        }
    },
    "widgets": [
        "menubar#top",
        "label#controls",
        "buttons-grid",
        "volume",
        "backlight",
        "mpris",
        "dnd",
        "inhibitors",
        "title",
        "notifications"
    ],
    "widget-config": {
        "menubar#top": {
            "buttons#user": {
                "position": "left",
                "actions": [
                    {
                        "label": "  Yoru Deck",
                        "command": "swaync-client -cp; nwg-look"
                    }
                ]
            },
            "menu#power": {
                "label": "",
                "position": "right",
                "animation-type": "slide_down",
                "animation-duration": 180,
                "actions": [
                    {
                        "label": "  Lock session",
                        "command": "swaync-client -cp; hyprlock"
                    },
                    {
                        "label": "  Suspend",
                        "command": "swaync-client -cp; hyprshutdown suspend 2>/dev/null || systemctl suspend"
                    },
                    {
                        "label": "  Power menu",
                        "command": "swaync-client -cp; ~/.config/rofi/launchers/powermenu.sh"
                    }
                ]
            }
        },
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "notifications": {
            "vexpand": true
        },
        "label#controls": {
            "max-lines": 1,
            "text": "QUICK SETTINGS"
        },
        "mpris": {
            "show-album-art": "when-available",
            "blacklist": ["playerctld"],
            "autohide": true,
            "loop-carousel": false
        },
        "volume": {
            "label": "󰕾 "
        },
        "backlight": {
            "label": "󰃠 ",
            "subsystem": "backlight",
            "min": 1
        },
        "inhibitors": {
            "text": "Inhibitors",
            "clear-all-button": true,
            "button-text": "Clear all"
        },
        "dnd": {
            "text": "Do not disturb"
        },
        "buttons-grid": {
            "buttons-per-row": 4,
            "actions": [
                {
                    "label": "󰕾  Sound",
                    "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
                    "type": "toggle",
                    "active": false,
                    "update-command": "~/.config/swaync/scripts/sink-state.sh"
                },
                {
                    "label": "  Mic",
                    "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
                    "type": "toggle",
                    "active": false,
                    "update-command": "~/.config/swaync/scripts/mic-state.sh"
                },
                {
                    "label": "  Wi-Fi",
                    "command": "~/.config/swaync/scripts/open-rofi.sh wifi",
                    "type": "toggle",
                    "active": false,
                    "update-command": "~/.config/swaync/scripts/wifi-state.sh"
                },
                {
                    "label": "󰂯  Bluetooth",
                    "command": "~/.config/swaync/scripts/open-rofi.sh bluetooth",
                    "type": "toggle",
                    "active": false,
                    "update-command": "~/.config/swaync/scripts/bluetooth-state.sh"
                },
                {
                    "label": "  Dark",
                    "command": "~/.config/swaync/scripts/toggle-theme.sh",
                    "type": "toggle",
                    "active": false,
                    "update-command": "~/.config/swaync/scripts/theme-state.sh"
                },
                {
                    "label": "  Capture",
                    "command": "~/.config/swaync/scripts/open-rofi.sh screenshot"
                },
                {
                    "label": "󰏘  Picker",
                    "command": "swaync-client -cp; hyprpicker -a"
                },
                {
                    "label": "  Power",
                    "command": "~/.config/swaync/scripts/open-rofi.sh powermenu"
                }
            ]
        }
    }
}
