# User-local state: needed live on the system, never committed.
gtk-setting/gtk-3.0/bookmarks
zsh/.zsh_history
zsh/.zcompdump*
# Local backups.
*.bak
*.back
*.bak-*
# Editor and merge debris.
*~
*.swp
*.swo
*.orig
*.rej
.DS_Store
Thumbs.db
*.zwc
*.log

# Maintenance plans
.maintenance/*

# Generated palette / wallpaper state: reproducible artifacts, never commit.
# Sources: matugen/templates/*, hyprland/wallpapers/*, waypaper/config.ini.example.
# Fresh systems regenerate via install.sh (phase_theming) + autostart set-wall.sh.
hyprland/modules/colors.lua
hyprland/hyprlock-colors.conf
waybar/colors/matugen.css
swaync/matugen/colors.css
kitty/themes/Matugen.conf
rofi/shared/colors.rasi
gtk-setting/gtk-3.0/colors.css
gtk-setting/gtk-4.0/colors.css
qt6ct/colors/matugen.conf
btop/themes/matugen.theme
matugen/themes/nvim-colors.json
zsh/generated/colors.sh
waypaper/config.ini

# Secrets guard: never commit credentials even if tooling drops them here.
.env
.env.*
*.pem
*.key
*credentials*
*token*
